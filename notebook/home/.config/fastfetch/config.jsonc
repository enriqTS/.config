{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/logo.txt",
        "padding": {
            "top": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "white"
        }
    },
    "modules": [
        {
            "type": "custom",
            "key": "╭────────────╮"
        },
        {
            "type": "os",
            "key": "│ {#35}{icon} OS{#keys}       │",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "│ {#36}{icon} Kernel{#keys}   │",
            "format": "{sysname} {release}"
        },
        {
            "type": "shell",
            "key": "│ {#35}{icon} Shell{#keys}    │",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "│ {#34}{icon} Terminal{#keys} │",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": "│ {#35}{icon} WM{#keys}       │",
            "format": "{pretty-name}"
        },
        {
            "type": "cpu",
            "key": "│ {#34}{icon} CPU{#keys}      │",
            "format": "lua:local a = ...; return (a.name:gsub('^%d+%a* Gen ', ''):gsub('%(R%)', ''):gsub('%(TM%)', ''))"
        },
        {
            "type": "gpu",
            "key": "│ {#35}{icon} GPU{#keys}      │",
            "format": "lua:local a = ...; local n = a.name:gsub(' Max%-Q /', ''); return a.vendor .. ' ' .. n"
        },
        {
            "type": "memory",
            "key": "│ {#34}{icon} Memory{#keys}   │",
            "format": "{used} / {total}"
        },
        {
            "type": "uptime",
            "key": "│ {#36}{icon} Uptime{#keys}   │",
            "format": "{formatted}"
        },
        {
            "type": "custom",
            "key": "├────────────┤"
        },
        {
            "type": "colors",
            "key": "│ {#35}{icon} Colors{#keys}   │",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "key": "╰────────────╯"
        }
    ]
}